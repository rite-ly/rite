# Rite live image package list
# See: https://live-team.pages.debian.net/live-manual/html/live-manual/customizing-package-installation.en.html
#
# live-boot, live-config and live-config-systemd are added by live-build.
# This list holds only what the image needs beyond them.

# Architecture-specific GRUB bootloader
#if ARCHITECTURES arm64
grub-efi-arm64
#endif

#if ARCHITECTURES amd64
grub-efi-amd64
#endif

# Required by live-config to create the rite user (a recommends, not installed
# with --apt-recommends false).
user-setup

# The rite user powers the machine off through a sudo rule limited to
# systemctl poweroff and reboot (see setup-hook.sh).
sudo
less

# Tab completion for rite in the session shell.
bash-completion

# Display stack: cage (wlroots kiosk compositor) runs foot fullscreen. dbus and
# libpam-systemd let logind open the session and set XDG_RUNTIME_DIR; without
# them cage exits at once ("XDG_RUNTIME_DIR is not set"). Neither is pulled in
# by live-config-systemd under --apt-recommends false.
#
# fonts-dejavu-core provides the TrueType font that foot's "monospace" alias
# resolves to through fontconfig. A minimal image ships none otherwise.
dbus
libpam-systemd
cage
foot
foot-terminfo
fonts-dejavu-core

# Libraries the rite binary links: system OpenSSL and the PC/SC client. The
# binary is the one from the rite Docker image, built on Debian trixie. Their
# versions are those Debian serves when the ISO is built, which the release
# records in the ISO's .packages file.
libssl3t64
libpcsclite1

# Smart cards (PIV, YubiKey): pcscd talks to the reader through the CCID
# driver, and asks polkit whether a client may use it; Debian's policy allows
# the user of an active local session, which the rite session is. The rule in
# rite.rules refuses that user every other polkit action.
pcscd
libccid
polkitd
