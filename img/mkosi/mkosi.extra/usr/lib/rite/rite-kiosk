#!/bin/bash
# /usr/lib/rite/rite-kiosk PROGRAM
# Runs PROGRAM (rite-session or rite-shell) inside cage + foot, or on the text
# console when the boot entry asks for it (rite.console) or cage fails to
# start. PROGRAM always exits 0, Ctrl-C included, and cage and foot pass on its
# status, so any other status means cage or foot failed. cage's own output goes
# to the journal. -s lets the operator switch terminals with Ctrl+Alt+F1 and
# Ctrl+Alt+F2, which cage turns off by default.

program=$1

# Apply the settings chosen in rite-setup: cage reads the XKB variables and
# session programs read TZ. The settings file is root-owned before the session
# starts. If it is absent or invalid, the session uses US and UTC.
# shellcheck disable=SC1091
source /usr/lib/rite/setup-values
if [[ -r $SETTINGS ]]; then
    while IFS='=' read -r key value; do
        case $key in
            layout) valid_layout "$value" && export XKB_DEFAULT_LAYOUT=$value ;;
            variant) valid_variant "$value" && export XKB_DEFAULT_VARIANT=$value ;;
            timezone) valid_zone "$value" && export TZ=$value ;;
        esac
    done < "$SETTINGS"
fi

if ! grep -qwF 'rite.console' /proc/cmdline; then
    # cage takes the display, which only the terminal on screen can do: the
    # second terminal starts cage when the operator first switches to it.
    terminal=$(basename "$(tty)")
    until [[ "$(cat /sys/class/tty/tty0/active)" == "$terminal" ]]; do
        sleep 0.5
    done
    systemd-cat -t cage cage -s -- foot "$program"
    status=$?
    if [[ $status -eq 0 ]]; then
        exit 0
    fi
    export RITE_SESSION_NOTICE="The graphical session failed (exit status $status). This session runs on the text console."
fi

exec "$program"
