#!/bin/bash
# /usr/lib/rite/mount-outputs
# Mounts the RITE-OUT partition of the stick the system booted from at
# /rite/outputs, for the rite user. Runs as root before each session start.
#
# A base image has no RITE-OUT partition, which is not an error. A failed mount
# is: its message goes to /run/rite/outputs-error, which rite-session shows the
# operator.
#
# flush writes data to the stick promptly, so outputs survive a power cut more
# often. The partition holds data only, so nothing on it may execute. FAT has
# no permissions of its own: umask=077 gives every file the 0600 that rite asks
# for its private artifacts.

OUTPUTS=/rite/outputs
ERROR_FILE=/run/rite/outputs-error

mountpoint -q "$OUTPUTS" && exit 0
mkdir -p /run/rite
rm -f "$ERROR_FILE"

device=$(/usr/lib/rite/boot-partition RITE-OUT) || exit 0

if ! error=$(mount -t vfat \
    -o "rw,flush,nosuid,nodev,noexec,uid=$(id -u rite),gid=$(id -g rite),umask=077" \
    "$device" "$OUTPUTS" 2>&1); then
    echo "$device: $error" > "$ERROR_FILE"
fi
exit 0
