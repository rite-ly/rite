#!/bin/bash
# img/auto/config
# Live-build configuration script
# See: https://live-team.pages.debian.net/live-manual/html/live-manual/managing-a-configuration.en.html
#
# Target environment: Debian trixie, Linux 6.12 (linux-image-amd64 / linux-image-arm64)
# Kernel parameters reference: https://docs.kernel.org/admin-guide/kernel-parameters.html
# When upgrading the distribution or kernel, re-validate all boot parameters below.

set -e

# Architecture is passed via environment variable
LB_ARCH="${LB_ARCH:-arm64}"

# console=tty0 (the display) is the only console. systemd.getty_auto=0 stops
# systemd from starting a login on serial or hypervisor consoles (hvc0) it
# finds on its own.
CONSOLES="console=tty0 systemd.getty_auto=0"

# live-config creates the rite user at boot. noroot keeps it from granting that
# user full sudo; the image's own sudoers rule allows only poweroff and reboot.
# noautologin stops live-config from adding autologin to the gettys.
LIVE_CONFIG="username=rite hostname=rite live-config.noroot live-config.noautologin"

# Memory hardening that works on any hardware. The options that depend on the
# hardware (memory encryption, IOMMU) are on the main boot entry only, in
# config/bootloaders/grub.cfg, so the safe mode entry can boot without them.
# https://docs.kernel.org/admin-guide/kernel-parameters.html
#
# init_on_free=1
#   Zeroes kernel memory pages when they are freed, so short-lived secrets
#   (stack frames, freed heap) do not linger until the page is reused.
#   Effective on all architectures. It does not clear memory still in use.
MEM_HARDENING="init_on_free=1"

# Kernel exploit surface reduction.
# https://docs.kernel.org/admin-guide/kernel-parameters.html
#
# slab_nomerge
#   Disables merging of slab caches with compatible sizes and alignment.
#   Merging allows an attacker to place a target object adjacent to a
#   controlled allocation, enabling heap overflow primitives. With this param,
#   each object type gets its own cache, breaking that adjacency assumption.
#   No effect on architectures or kernels built without CONFIG_SLUB.
#   NOTE: proposed for removal in future kernels (may become a build-time
#   default); re-validate when upgrading past Linux 6.12.
#
# vsyscall=none
#   Removes the vsyscall page entirely. The vsyscall page sits at a fixed
#   virtual address (0xffffffffff600000 on x86-64), making it a reliable
#   source of ROP gadgets. Disabling it eliminates those gadgets at the cost
#   of breaking very old glibc (< 2.14) that calls vsyscall directly.
#   x86-64 only, silently ignored on ARM64 (vsyscall does not exist there).
#
# debugfs=off
#   Prevents the debugfs filesystem from registering, so kernel subsystems
#   cannot expose internal state via /sys/kernel/debug. Removes a class of
#   information-disclosure paths used in local privilege escalation. Note:
#   this prevents registration, not the mount point itself; the directory
#   may still exist but will be empty and unusable.
#
# randomize_kstack_offset=1
#   Adds a small random offset to the kernel stack pointer at each syscall
#   entry, making stack layouts non-deterministic across calls. Defeats
#   ROP chains that rely on predictable kernel stack addresses. ~5 bits of
#   entropy; <1% performance overhead. Effective on x86-64 and ARM64.
#   The kernel default depends on CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT;
#   this param ensures it is always on regardless of build config.
KERNEL_HARDENING="slab_nomerge vsyscall=none debugfs=off randomize_kstack_offset=1"

lb config noauto \
    --distribution trixie \
    --architectures "$LB_ARCH" \
    --archive-areas "main" \
    --debian-installer none \
    --bootloaders grub-efi \
    --binary-images iso-hybrid \
    --chroot-squashfs-compression-type zstd \
    --iso-application "Rite Runtime" \
    --iso-publisher "Rite-ly" \
    --iso-volume "RITE-LIVE" \
    \
    --debootstrap-options "--variant=minbase" \
    --apt-recommends false \
    --apt-indices false \
    --memtest none \
    --win32-loader false \
    --loadlin false \
    --security true \
    --updates true \
    --backports false \
    --source false \
    --zsync false \
    \
    --bootappend-live "boot=live components ${LIVE_CONFIG} ${CONSOLES} ${MEM_HARDENING} ${KERNEL_HARDENING}" \
    "${@}"
