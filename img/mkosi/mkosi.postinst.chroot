#!/bin/bash
# img/mkosi/mkosi.postinst.chroot
# Runs inside the image during build-system, after the packages, the files of
# mkosi.extra and the rite binary are installed.
set -euo pipefail

# The session user. useradd leaves its password locked: the sessions start
# without a login, and nothing else logs in.
useradd --create-home --uid 1000 --user-group --shell /bin/bash rite

# The ceremony layer is a system extension, which covers /usr only, so its files
# are under /usr/share/rite. These links keep the paths the session and the
# documentation use. /rite/outputs belongs to the rite user, so a ceremony can
# write there when no RITE-OUT partition is mounted.
mkdir -p /rite /usr/share/rite
ln -s ../usr/share/rite/inputs /rite/inputs
ln -s ../usr/share/rite/ceremonies /rite/ceremonies
install -d -o rite -g rite /rite/outputs

# The rite version identifies the image, as IMAGE_VERSION in os-release.
echo "IMAGE_VERSION=$(rite --version | awk '{ print $2 }')" >> /usr/lib/os-release

# Completion for the rite CLI, generated by the binary in the image so it
# matches that version.
rite completions bash > /usr/share/bash-completion/completions/rite

# rite-session and rite-shell own tty1 and tty2.
systemctl mask getty@tty1.service getty@tty2.service

# mkosi.conf sets the locale, keymap, time zone and host name, so nothing asks
# for them at the console.
systemctl mask systemd-firstboot.service

# systemd would mount the EFI system partition read-write on first access to
# /boot or /efi. The system needs nothing there after boot, and a mount can
# change the partition's bytes, which the medium hash of build-img covers.
systemctl mask boot.automount efi.automount

# systemd-pcrlock writes a policy into the TPM; see systemd.tpm2_wait=0 in
# mkosi.conf for the rest of the TPM setup.
systemctl mask systemd-pcrlock-file-system.service \
    systemd-pcrlock-firmware-code.service \
    systemd-pcrlock-firmware-config.service \
    systemd-pcrlock-machine-id.service \
    systemd-pcrlock-make-policy.service \
    systemd-pcrlock-secureboot-authority.service \
    systemd-pcrlock-secureboot-policy.service
